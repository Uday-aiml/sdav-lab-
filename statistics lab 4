      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import stats\n",
        "\n",
        "np.random.seed(42)\n",
        "x=np.linspace(-4,4,400)\n",
        "std_normal=stats.norm(0,1)\n",
        "print('68-95-99.7 Rule:')\n",
        "print(f'P(-1<Z<1) = {std_normal.cdf(1)-std_normal.cdf(-1):.6f}')\n",
        "print(f'P(-2<Z<2) = {std_normal.cdf(2)-std_normal.cdf(-2):.6f}')\n",
        "print(f'P(-3<Z<3) = {std_normal.cdf(3)-std_normal.cdf(-3):.6f}')"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Z-Score Standardization\n",
        "mu_exam, sigma_exam = 70, 10\n",
        "for score in [60, 70, 80, 90]:\n",
        "    z = (score - mu_exam) / sigma_exam\n",
        "    pct = std_normal.cdf(z) * 100\n",
        "    print(f'   Score={score}: Z={z:.2f}, Percentile={pct:.1f}%')"
      ],
