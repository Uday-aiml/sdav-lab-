      "source": [
        "# --- EXPONENTIAL DISTRIBUTION ---\n",
        "lam = 1.0\n",
        "exp_dist = stats.expon(scale=1/lam)\n",
        "print(f'Exp(λ=1): Mean={exp_dist.mean()}, Var={exp_dist.var()}')\n",
        "\n",
        "# Memoryless Property\n",
        "print(f'P(X>2)     = {(1-exp_dist.cdf(2)):.6f}')\n",
        "print(f'P(X>3|X>1) = {(1-exp_dist.cdf(3))/(1-exp_dist.cdf(1)):.6f}')"
      ],
